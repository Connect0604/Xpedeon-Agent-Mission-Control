@page "/agents/create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject AgentService AgentService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject LLMProviderService ProviderService
@inject TemplateService TemplateService
@inject SkillService SkillService
@inject NavigationManager Nav

<PageTitle>Create Agent — Xpedeon AMC</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Create Agent</h1>
        <p class="page-subtitle">Set up an agent, connect its model, and define how it should behave.</p>
    </div>
    <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/agents")'>
        <i class="bi bi-arrow-left"></i> Back
    </button>
</div>

<div class="create-agent-layout">

    <!-- Left: Steps / Progress -->
    <div class="create-agent-steps">
        <div class="step-item @(currentStep >= 1 ? "step-item--done" : "") @(currentStep == 1 ? "step-item--active" : "")">
            <div class="step-num">@(currentStep > 1 ? "✓" : "1")</div>
            <div class="step-label">Basics</div>
        </div>
        <div class="step-connector"></div>
        <div class="step-item @(currentStep >= 2 ? "step-item--done" : "") @(currentStep == 2 ? "step-item--active" : "")">
            <div class="step-num">@(currentStep > 2 ? "✓" : "2")</div>
            <div class="step-label">Model</div>
        </div>
        <div class="step-connector"></div>
        <div class="step-item @(currentStep >= 3 ? "step-item--done" : "") @(currentStep == 3 ? "step-item--active" : "")">
            <div class="step-num">@(currentStep > 3 ? "✓" : "3")</div>
            <div class="step-label">Memory</div>
        </div>
        <div class="step-connector"></div>
        <div class="step-item @(currentStep >= 4 ? "step-item--done" : "") @(currentStep == 4 ? "step-item--active" : "")">
            <div class="step-num">@(currentStep > 4 ? "✓" : "4")</div>
            <div class="step-label">Safety</div>
        </div>
        <div class="step-connector"></div>
        <div class="step-item @(currentStep >= 5 ? "step-item--active" : "")">
            <div class="step-num">5</div>
            <div class="step-label">Spawning</div>
        </div>
    </div>

    <!-- Right: Form -->
    <div class="create-agent-form">

        <!-- Step 1: Basics -->
        @if (currentStep == 1)
        {
            <div class="card card-pad">
                <h3 class="section-title mb-4">Agent Basics</h3>
                <p class="form-section-intro">Start with identity and intent. This is the information people will scan first in the fleet.</p>

                <!-- Template picker -->
                @if (templates.Any())
                {
                    <div class="form-group">
                        <label class="form-label">Start from a template <span class="text-muted text-xs">(optional)</span></label>
                        <div class="template-picker">
                            <div class="template-picker-item @(selectedTemplateId == null ? "selected" : "")"
                                 @onclick='() => ApplyTemplate(null)'>
                                <i class="bi bi-braces"></i>
                                <span>Blank</span>
                            </div>
                            @foreach (var t in templates)
                            {
                                <div class="template-picker-item @(selectedTemplateId == t.Id ? "selected" : "")"
                                     @onclick="() => ApplyTemplate(t)">
                                    <i class="bi @(t.IconClass ?? "bi-robot")"></i>
                                    <span>@t.Name</span>
                                </div>
                            }
                        </div>
                        <div class="form-hint">
                            <i class="bi bi-info-circle"></i>
                            Templates prefill the prompt and defaults. You can still change everything later.
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label class="form-label">Agent Name <span class="text-error">*</span></label>
                    <input class="form-input" @bind="agent.Name" placeholder="e.g. Invoice Validator" />
                    <div class="form-hint">Choose a short, recognizable name that will still make sense in task history.</div>
                </div>

                <div class="form-group">
                    <label class="form-label">Agent Type <span class="text-error">*</span></label>
                    <div class="type-picker">
                        @foreach (var t in Enum.GetValues<AgentType>())
                        {
                            <button class="type-btn @(agent.Type == t ? "type-btn--active" : "")"
                                    @onclick="() => agent.Type = t">
                                <i class="bi @TypeIcon(t)"></i>
                                <span>@t</span>
                            </button>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea class="form-input" rows="3" @bind="agent.Description"
                              placeholder="Describe the job this agent owns and the kind of output you expect."></textarea>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Host Machine</label>
                        <input class="form-input font-mono" @bind="agent.HostMachine"
                               placeholder="worker-01.xpedeon.local" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Version</label>
                        <input class="form-input font-mono" @bind="agent.Version" placeholder="1.0.0" />
                    </div>
                </div>
            </div>
        }

        <!-- Step 2: LLM & System Prompt -->
        @if (currentStep == 2)
        {
            <div class="card card-pad">
                <h3 class="section-title mb-4">Model & Prompt</h3>
                <p class="form-section-intro">Pick where the agent runs, which provider it uses, and the exact instructions it should follow.</p>

                <div class="form-group">
                    <label class="form-label">Execution Backend</label>
                    <div class="type-picker">
                        @foreach (var backend in Enum.GetValues<ExecutionBackend>())
                        {
                            <button class="type-btn @(agent.ExecutionBackend == backend ? "type-btn--active" : "")"
                                    @onclick="() => agent.ExecutionBackend = backend">
                                <i class="bi @(backend == ExecutionBackend.Local ? "bi-cpu" : "bi-box-arrow-up-right")"></i>
                                <span>@(backend == ExecutionBackend.Local ? "Local" : "Hermes/OpenClaw")</span>
                            </button>
                        }
                    </div>
                    <div class="form-hint">
                        <i class="bi bi-info-circle"></i>
                        Local runs stay inside Mission Control. Hermes/OpenClaw delegates execution to the external runtime after approval.
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">LLM Provider <span class="text-error">*</span></label>
                    @if (!providers.Any())
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            No providers configured.
                            <a href="/providers" class="text-accent">Add a provider first</a>
                        </div>
                    }
                    else
                    {
                        <div class="provider-picker">
                            @foreach (var p in providers)
                            {
                                <div class="provider-picker-item @(agent.LLMProviderId == p.Id ? "selected" : "")"
                                     @onclick="() => agent.LLMProviderId = p.Id">
                                    <i class="bi @ProviderIcon(p.Type)"></i>
                                    <div>
                                        <div class="text-sm font-medium">@p.Name</div>
                                        <div class="text-xs font-mono text-muted">@p.ModelName</div>
                                    </div>
                                    @if (p.IsDefault)
                                    {
                                        <span class="badge badge-accent ml-auto text-xs">Default</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="form-group">
                    <label class="form-label">
                        System Prompt <span class="text-error">*</span>
                        <span class="text-muted text-xs ml-2">— defines what this agent does and how it behaves</span>
                    </label>
                    <textarea class="form-input font-mono prompt-editor" rows="12"
                              @bind="agent.SystemPrompt"
                              placeholder="You are an AI agent that...&#10;&#10;Your responsibilities:&#10;1. ...&#10;2. ...&#10;&#10;Always:&#10;- ...&#10;&#10;Never:&#10;- ..."></textarea>
                    <div class="form-hint">
                        <i class="bi bi-info-circle"></i>
                        Be specific. Describe the role, responsibilities, output format, and constraints.
                        @if (!string.IsNullOrWhiteSpace(agent.SystemPrompt))
                        {
                            <span class="ml-auto text-muted">~@EstimateTokens(agent.SystemPrompt) tokens</span>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Step 3: Memory & Tools -->
        @if (currentStep == 3)
        {
            <div class="card card-pad">
                <h3 class="section-title mb-4">Memory Configuration</h3>
                <p class="form-section-intro">Decide what the agent should remember between runs and what capabilities it can use.</p>

                <div class="toggle-group">
                    <div class="toggle-item">
                        <div>
                            <div class="toggle-label">Short-term Memory</div>
                            <div class="toggle-desc text-muted text-sm">Maintains context within a single task run</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="agent.ShortTermMemoryEnabled" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="toggle-item">
                        <div>
                            <div class="toggle-label">Long-term Memory</div>
                            <div class="toggle-desc text-muted text-sm">Persists learnings across task runs</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="agent.LongTermMemoryEnabled" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="toggle-item">
                        <div>
                            <div class="toggle-label">Share Memory with Swarm</div>
                            <div class="toggle-desc text-muted text-sm">Pool memory with other agents in the same swarm</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="agent.ShareMemoryWithSwarm" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="card card-pad mt-4">
                <h3 class="section-title mb-4">MCP Servers</h3>
                <p class="form-section-intro">Attach non-global MCP servers only when this agent truly needs them.</p>
                @if (!allMcpServers.Any())
                {
                    <div class="text-muted text-sm">No MCP servers configured. <a href="/mcp" class="text-accent">Add one first.</a></div>
                }
                else
                {
                    <div class="mcp-assign-list">
                        @foreach (var mcp in allMcpServers)
                        {
                            var isAssigned = assignedMcpIds.Contains(mcp.Id);
                            <label class="mcp-assign-row @(isAssigned ? "mcp-assign-row--on" : "")">
                                <input type="checkbox" checked="@isAssigned"
                                       @onchange="e => ToggleMcp(mcp.Id, (bool)(e.Value ?? false))" />
                                <div class="mcp-assign-info">
                                    <span class="text-sm font-medium">@mcp.Name</span>
                                    @if (mcp.IsGlobal)
                                    {
                                        <span class="badge badge-accent ml-2 text-xs">Global</span>
                                    }
                                    <div class="text-xs font-mono text-muted">@mcp.Endpoint</div>
                                </div>
                                <span class="mcp-transport-badge @mcp.TransportType.ToString().ToLower() ml-auto">@mcp.TransportType</span>
                            </label>
                        }
                    </div>
                }
            </div>

            <div class="card card-pad mt-4">
                <h3 class="section-title mb-4">Capability Skills</h3>
                <p class="form-section-intro">Attach reusable skills that influence prompt framing, guardrails, and tool limits.</p>
                @if (!skillsCatalog.Any())
                {
                    <div class="text-muted text-sm">No skills are configured.</div>
                }
                else
                {
                    @foreach (var skillGroup in SkillsByCategory(skillsCatalog))
                    {
                        <div class="mt-3">
                            <div class="text-xs text-muted mb-2">@skillGroup.Key</div>
                            <div class="skill-pick-grid">
                                @foreach (var skill in skillGroup)
                                {
                                    <div class="skill-pick-card @(selectedSkillIds.Contains(skill.Id) ? "skill-pick-card--selected" : "")"
                                         @onclick="() => ToggleSkill(skill.Id)">
                                        <div class="flex items-start gap-3">
                                            <div class="provider-icon provider-icon--custom">
                                                <i class="bi bi-stars"></i>
                                            </div>
                                            <div style="flex:1;">
                                                <div class="text-sm font-medium">@skill.Name</div>
                                                <div class="text-xs text-muted mt-1">@skill.Description</div>
                                                <div class="text-xs text-muted mt-2">
                                                    <span class="tag">@skill.Category</span>
                                                    @if (skill.RequiresApproval)
                                                    {
                                                        <span class="tag">Approval</span>
                                                    }
                                                    @if (skill.MaxToolCalls.HasValue)
                                                    {
                                                        <span class="tag">Max @skill.MaxToolCalls tools</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (selectedSkillIds.Contains(skill.Id))
                                            {
                                                <i class="bi bi-check-circle-fill text-accent"></i>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="card card-pad mt-4">
                <h3 class="section-title mb-4">Tools</h3>
                <p class="form-section-intro">Only enable the capabilities this agent really needs. Fewer tools usually means safer behavior.</p>
                <div class="tools-grid">
                    @foreach (var tool in availableTools)
                    {
                        <div class="tool-item @(selectedTools.Contains(tool.Key) ? "tool-item--active" : "")"
                             @onclick="() => ToggleTool(tool.Key)">
                            <i class="bi @tool.Value.icon"></i>
                            <div>
                                <div class="text-sm font-medium">@tool.Key</div>
                                <div class="text-xs text-muted">@tool.Value.desc</div>
                            </div>
                            @if (selectedTools.Contains(tool.Key))
                            {
                                <i class="bi bi-check-circle-fill text-accent ml-auto"></i>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card card-pad mt-4">
                <h3 class="section-title mb-4">Local Automation</h3>
                <p class="form-section-intro">Enable this only for agents that should act on the Mission Control host machine.</p>
                <div class="toggle-group">
                    <div class="toggle-item">
                        <div>
                            <div class="toggle-label">Enable Local Automation</div>
                            <div class="toggle-desc text-muted text-sm">Lets the agent plan and run validated local file actions on this machine.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="agent.LocalAutomationEnabled" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="toggle-item">
                        <div>
                            <div class="toggle-label">Allow PowerShell</div>
                            <div class="toggle-desc text-muted text-sm">Allow planner output to execute PowerShell after approval checks.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="agent.AllowPowerShellScripts" disabled="@(!agent.LocalAutomationEnabled)" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="toggle-item">
                        <div>
                            <div class="toggle-label">Allow Destructive Actions</div>
                            <div class="toggle-desc text-muted text-sm">Permit delete and overwrite actions after validation.</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="agent.AllowDestructiveActions" disabled="@(!agent.LocalAutomationEnabled)" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                @if (agent.LocalAutomationEnabled)
                {
                    <div class="form-group mt-4">
                        <label class="form-label">Automation Approval Mode</label>
                        <select class="form-input" @bind="agent.LocalAutomationApprovalMode">
                            <option value="@LocalAutomationApprovalMode.Restricted">Restricted - approve every local action</option>
                            <option value="@LocalAutomationApprovalMode.ApproveRiskyOnly">Approve risky only</option>
                            <option value="@LocalAutomationApprovalMode.FullControl">Full control - no local approval gates</option>
                        </select>
                        <div class="form-hint">
                            <i class="bi bi-info-circle"></i>
                            This setting controls local automation approvals only. The general agent approval toggle still applies separately.
                        </div>
                    </div>

                    <div class="form-group mt-4">
                        <label class="form-label">Allowed Root Paths</label>
                        <textarea class="form-input font-mono" rows="4" @bind="allowedRootsText"
                                  placeholder="One absolute path per line&#10;C:\Exports&#10;D:\DropFolders"></textarea>
                        <div class="form-hint">
                            <i class="bi bi-info-circle"></i>
                            The agent can only touch files under these roots.
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Step 4: Advanced -->
        @if (currentStep == 4)
        {
            <div class="card card-pad">
                <h3 class="section-title mb-4">Resource Limits</h3>
                <p class="form-section-intro">Set the cost, retry, and reliability guardrails that keep this agent predictable.</p>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Memory Limit (MB)</label>
                        <input class="form-input" type="number" @bind="agent.MemoryLimitMB" min="64" max="8192" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Timeout (seconds)</label>
                        <input class="form-input" type="number" @bind="agent.TimeoutSeconds" min="10" max="3600" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Max Retries</label>
                        <input class="form-input" type="number" @bind="agent.MaxRetries" min="0" max="10" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Daily Token Budget</label>
                        <input class="form-input" type="number" @bind="tokenBudget"
                               placeholder="Leave blank for unlimited" />
                    </div>
                </div>
            </div>

            <div class="card card-pad mt-4">
                <h3 class="section-title mb-4">Reliability & Safety</h3>
                <div class="toggle-group">
                    <div class="toggle-item">
                        <div>
                            <div class="toggle-label">Circuit Breaker</div>
                            <div class="toggle-desc text-muted text-sm">Auto-pause agent after @agent.CircuitBreakerFailureThreshold consecutive failures</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="agent.CircuitBreakerEnabled" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                    <div class="toggle-item">
                        <div>
                            <div class="toggle-label">Require Human Approval</div>
                            <div class="toggle-desc text-muted text-sm">Tasks wait for manual approval before executing</div>
                        </div>
                        <label class="toggle-switch">
                            <input type="checkbox" @bind="agent.RequiresApproval" />
                            <span class="toggle-slider"></span>
                        </label>
                    </div>
                </div>

                @if (agent.CircuitBreakerEnabled)
                {
                    <div class="form-group mt-4">
                        <label class="form-label">Failure Threshold</label>
                        <input class="form-input" type="number" @bind="agent.CircuitBreakerFailureThreshold" min="2" max="20" />
                    </div>
                }

                @if (agent.RequiresApproval)
                {
                    <div class="form-group mt-4">
                        <label class="form-label">Confidence Threshold <span class="text-muted text-xs">(auto-approve above this)</span></label>
                        <input class="form-input" type="number" @bind="agent.ConfidenceThreshold" min="0" max="1" step="0.05" />
                    </div>
                }

                <div class="mt-4">
                    <h4 class="section-title mb-3">Schedule (Cron)</h4>
                    <label class="form-check mb-3">
                        <input type="checkbox" @bind="scheduleEnabled" />
                        <span>Enable scheduled runs</span>
                    </label>
                    @if (scheduleEnabled)
                    {
                        <div class="form-group mb-3">
                            <label class="form-label">Quick Presets</label>
                            <div class="type-picker">
                                @foreach (var preset in schedulePresets)
                                {
                                    <button type="button"
                                            class="type-btn @(cronExpression == preset.Expression ? "type-btn--active" : "")"
                                            @onclick='() => ApplySchedulePreset(preset.Expression)'>
                                        <i class="bi bi-clock-history"></i> @preset.Label
                                    </button>
                                }
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Cron Expression</label>
                                <input class="form-input font-mono" @bind="cronExpression" placeholder="0 9 * * *" />
                                <div class="form-hint">
                                    <i class="bi bi-info-circle"></i>
                                    @CronHint(cronExpression)
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Priority</label>
                                <select class="form-input" @bind="schedulePriority">
                                    @foreach (var p in Enum.GetValues<TaskPriority>())
                                    {
                                        <option value="@p">@p</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Default Input</label>
                            <textarea class="form-input" rows="3" @bind="scheduleInput"
                                      placeholder="Default task input sent on each scheduled run..."></textarea>
                        </div>
                        <div class="token-stats">
                            <div class="token-stat">
                                <span class="text-muted text-xs">Next Run</span>
                                <span>@NextRunPreview</span>
                            </div>
                            <div class="token-stat">
                                <span class="text-muted text-xs">Last Run</span>
                                <span>Never</span>
                            </div>
                            <div class="token-stat">
                                <span class="text-muted text-xs">Total Runs</span>
                                <span>0</span>
                            </div>
                            <div class="token-stat">
                                <span class="text-muted text-xs">Mode</span>
                                <span>@(agent.ExecutionBackend == ExecutionBackend.HermesOpenClaw ? "Delegated" : "Local")</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Summary -->
            <div class="card card-pad mt-4 agent-summary">
                <h3 class="section-title mb-3">Summary</h3>
                <p class="form-section-intro">Sanity-check the final setup before you move on to spawning configuration.</p>
                <div class="summary-grid">
                    <div class="summary-item">
                        <span class="text-muted text-xs">Name</span>
                        <span class="text-sm font-medium">@(string.IsNullOrEmpty(agent.Name) ? "—" : agent.Name)</span>
                    </div>
                    <div class="summary-item">
                        <span class="text-muted text-xs">Type</span>
                        <span class="text-sm">@agent.Type</span>
                    </div>
                    <div class="summary-item">
                        <span class="text-muted text-xs">Execution Backend</span>
                        <span class="text-sm">@agent.ExecutionBackend</span>
                    </div>
                    <div class="summary-item">
                        <span class="text-muted text-xs">LLM Provider</span>
                        <span class="text-sm">@(providers.FirstOrDefault(p => p.Id == agent.LLMProviderId)?.DisplayName ?? "Not set")</span>
                    </div>
                    <div class="summary-item">
                        <span class="text-muted text-xs">System Prompt</span>
                        <span class="text-sm">@(string.IsNullOrWhiteSpace(agent.SystemPrompt) ? "Not set" : $"~{EstimateTokens(agent.SystemPrompt)} tokens")</span>
                    </div>
                    <div class="summary-item">
                        <span class="text-muted text-xs">Memory</span>
                        <span class="text-sm">@MemorySummary()</span>
                    </div>
                    <div class="summary-item">
                        <span class="text-muted text-xs">Tools</span>
                        <span class="text-sm">@(selectedTools.Any() ? string.Join(", ", selectedTools) : "None")</span>
                    </div>
                    <div class="summary-item">
                        <span class="text-muted text-xs">Skills</span>
                        <span class="text-sm">
                            @(selectedSkillIds.Any()
                                ? string.Join(", ", skillsCatalog.Where(s => selectedSkillIds.Contains(s.Id)).Select(s => s.Name))
                                : "None")
                        </span>
                    </div>
                </div>
            </div>

        }

        <!-- Step 5: Spawning -->
        @if (currentStep == 5)
        {
            <div class="card card-pad">
                <h3 class="section-title mb-4">Dynamic Agent Spawning</h3>
                <p class="form-section-intro">Configure whether this agent should break work into smaller child tasks at runtime.</p>
                <div class="toggle-item mb-4">
                    <div>
                        <div class="toggle-label">Enable Dynamic Spawning</div>
                        <div class="toggle-desc text-muted text-sm">Agent spawns child agents at runtime based on task input</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="agent.SpawnEnabled" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                @if (agent.SpawnEnabled)
                {
                    <div class="form-group">
                        <label class="form-label">Spawn Mode</label>
                        <div class="strategy-picker">
                            <button class="strategy-btn @(agent.SpawnMode == AgentSpawnMode.RuleBased ? "strategy-btn--active" : "")"
                                    @onclick='() => agent.SpawnMode = AgentSpawnMode.RuleBased'>
                                <i class="bi bi-scissors"></i>
                                <div class="strategy-btn__name">Rule-Based</div>
                                <div class="strategy-btn__desc">Split input by pattern</div>
                            </button>
                            <button class="strategy-btn @(agent.SpawnMode == AgentSpawnMode.LLMDecided ? "strategy-btn--active" : "")"
                                    @onclick='() => agent.SpawnMode = AgentSpawnMode.LLMDecided'>
                                <i class="bi bi-stars"></i>
                                <div class="strategy-btn__name">LLM-Decided</div>
                                <div class="strategy-btn__desc">LLM decides decomposition</div>
                            </button>
                        </div>
                    </div>
                    @if (agent.SpawnMode == AgentSpawnMode.RuleBased)
                    {
                        <div class="form-group">
                            <label class="form-label">Split Input By</label>
                            <select class="form-input" @bind="agent.SpawnTriggerType">
                                <option value="@AgentSpawnTriggerType.SplitByNewline">New line</option>
                                <option value="@AgentSpawnTriggerType.SplitByComma">Comma-separated</option>
                                <option value="@AgentSpawnTriggerType.JsonArray">JSON array</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Child Prompt Template <span class="text-muted text-xs">optional</span></label>
                            <textarea class="form-input" rows="3" @bind="agent.ChildPromptTemplate"
                                      placeholder="Use {item} and {n}. Leave blank to inherit parent prompt."></textarea>
                        </div>
                    }
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Max Spawns</label>
                            <input class="form-input" type="number" @bind="agent.MaxSpawns" min="1" max="100" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Max Depth</label>
                            <input class="form-input" type="number" @bind="agent.MaxDepth" min="1" max="5" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Child Lifecycle</label>
                        <select class="form-input" @bind="agent.SpawnLifecycle">
                            <option value="@AgentSpawnLifecycle.Ephemeral">Ephemeral — deleted after task</option>
                            <option value="@AgentSpawnLifecycle.Pooled">Pooled — returned to Idle</option>
                            <option value="@AgentSpawnLifecycle.Persistent">Persistent — kept with memory</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Result Aggregation</label>
                        <select class="form-input" @bind="agent.SpawnAggregation">
                            <option value="@AgentSpawnAggregation.CollectAll">Collect All</option>
                            <option value="@AgentSpawnAggregation.FirstWins">First Wins</option>
                            <option value="@AgentSpawnAggregation.Voting">Voting</option>
                            <option value="@AgentSpawnAggregation.LLMSynthesize">LLM Synthesize</option>
                        </select>
                    </div>
                    <div class="spawn-preview-box">
                        <i class="bi bi-info-circle text-accent"></i>
                        <span class="text-sm">
                            Up to <strong>@agent.MaxSpawns</strong> child agents ·
                            <strong>@agent.SpawnLifecycle</strong> lifecycle ·
                            <strong>@agent.SpawnAggregation</strong> aggregation ·
                            max depth <strong>@agent.MaxDepth</strong>
                        </span>
                    </div>
                }
            </div>
        }

        <!-- Navigation buttons -->
        <div class="form-actions mt-4">
            @if (!string.IsNullOrWhiteSpace(errorMsg))
            {
                <div class="alert alert-error w-full mb-3">@errorMsg</div>
            }
            @if (currentStep > 1)
            {
                <button class="btn btn-ghost" @onclick="PrevStep">
                    <i class="bi bi-arrow-left"></i> Back
                </button>
            }
            else
            {
                <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/agents")'>Cancel</button>
            }

            @if (currentStep < 5)
            {
                <button class="btn btn-primary ml-auto" @onclick="NextStep">
                    Next <i class="bi bi-arrow-right"></i>
                </button>
            }
            else
            {
                <button class="btn btn-primary ml-auto" @onclick="SubmitAgent" disabled="@isSaving">
                    @if (isSaving) { <span class="spinner"></span> }
                    <i class="bi bi-check-lg"></i> @(isSaving ? "Creating..." : "Create Agent")
                </button>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] private string? templateId { get; set; }

    private Agent agent = CreateDefaultAgent();

    private List<LLMProvider> providers = new();
    private List<AgentTemplate> templates = new();
    private List<MCPServer> allMcpServers = new();
    private List<SkillDefinition> skillsCatalog = new();
    private string? selectedTemplateId;
    private HashSet<string> selectedTools = new();
    private HashSet<string> selectedSkillIds = new();
    private HashSet<string> assignedMcpIds = new();
    private int currentStep = 1;
    private bool isSaving;
    private string errorMsg = "";
    private long? tokenBudget;
    private string allowedRootsText = "";
    private bool scheduleEnabled;
    private string cronExpression = "0 9 * * *";
    private string scheduleInput = "";
    private TaskPriority schedulePriority = TaskPriority.Medium;

    private static readonly (string Label, string Expression)[] schedulePresets =
    {
        ("Hourly", "0 * * * *"),
        ("Daily 9 AM", "0 9 * * *"),
        ("Weekdays 9 AM", "0 9 * * 1,2,3,4,5"),
        ("Monday 9 AM", "0 9 * * 1")
    };

    private static readonly Dictionary<string, (string icon, string desc)> availableTools = new()
    {
        ["HTTP Request"]    = ("bi-cloud-arrow-up",     "Call external REST APIs"),
        ["Database Query"]  = ("bi-database",            "Read/write database records"),
        ["File I/O"]        = ("bi-file-earmark-text",  "Read and write files"),
        ["Email"]           = ("bi-envelope",            "Send email notifications"),
        ["Web Search"]      = ("bi-search",              "Search the web for information"),
        ["Calculator"]      = ("bi-calculator",          "Precise numeric computation"),
        ["Script Runner"]   = ("bi-terminal",            "Execute scripts"),
    };

    protected override async Task OnInitializedAsync()
    {
        providers = await ProviderService.GetAllAsync();
        templates = await TemplateService.GetAllAsync();
        skillsCatalog = await SkillService.GetAllAsync();

        await using var db = DbFactory.CreateDbContext();
        allMcpServers = await db.MCPServers
            .Where(m => m.IsEnabled)
            .OrderBy(m => m.Name)
            .ToListAsync();

        // Set default provider
        var def = providers.FirstOrDefault(p => p.IsDefault) ?? providers.FirstOrDefault();
        if (def != null) agent.LLMProviderId = def.Id;

        // Pre-select template from query string
        if (!string.IsNullOrWhiteSpace(templateId))
        {
            var t = templates.FirstOrDefault(x => x.Id == templateId);
            if (t != null) ApplyTemplate(t);
        }

        allowedRootsText = AllowedRootsToText(agent.AllowedLocalRootsJson);
    }

    private void ApplyTemplate(AgentTemplate? t)
    {
        selectedTemplateId = t?.Id;
        if (t == null)
        {
            var currentProviderId = agent.LLMProviderId;
            agent = CreateDefaultAgent();
            agent.LLMProviderId = currentProviderId;
            selectedTools.Clear();
            selectedSkillIds.Clear();
            allowedRootsText = "";
            return;
        }

        agent.Type = t.DefaultType;
        agent.Description = t.Description;
        agent.SystemPrompt = t.SystemPrompt;
        agent.TemplateId = t.Id;
        if (string.IsNullOrWhiteSpace(agent.Name)) agent.Name = t.Name;
        allowedRootsText = AllowedRootsToText(agent.AllowedLocalRootsJson);
    }

    private void ToggleTool(string tool)
    {
        if (!selectedTools.Remove(tool)) selectedTools.Add(tool);
    }

    private void ToggleSkill(string skillId)
    {
        if (!selectedSkillIds.Remove(skillId)) selectedSkillIds.Add(skillId);
    }

    private void ToggleMcp(string mcpId, bool assigned)
    {
        if (assigned) assignedMcpIds.Add(mcpId);
        else assignedMcpIds.Remove(mcpId);
    }

    private void ApplySchedulePreset(string expression)
    {
        cronExpression = expression;
    }

    private static IEnumerable<IGrouping<SkillCategory, SkillDefinition>> SkillsByCategory(IEnumerable<SkillDefinition> skills)
        => skills
            .OrderBy(s => s.Category)
            .ThenBy(s => s.Name)
            .GroupBy(s => s.Category);

    private void NextStep()
    {
        errorMsg = "";
        if (currentStep == 1)
        {
            if (string.IsNullOrWhiteSpace(agent.Name)) { errorMsg = "Agent name is required."; return; }
        }
        else if (currentStep == 2)
        {
            if (string.IsNullOrWhiteSpace(agent.SystemPrompt)) { errorMsg = "System prompt is required."; return; }
            if (string.IsNullOrWhiteSpace(agent.LLMProviderId)) { errorMsg = "Please select an LLM provider."; return; }
        }
        currentStep++;
    }

    private void PrevStep() => currentStep--;

    private async Task SubmitAgent()
    {
        errorMsg = "";
        if (string.IsNullOrWhiteSpace(agent.Name)) { errorMsg = "Agent name is required."; currentStep = 1; return; }
        if (string.IsNullOrWhiteSpace(agent.SystemPrompt)) { errorMsg = "System prompt is required."; currentStep = 2; return; }
        if (string.IsNullOrWhiteSpace(agent.LLMProviderId)) { errorMsg = "Please select an LLM provider."; currentStep = 2; return; }

        var agentToCreate = selectedTemplateId != null
            ? await TemplateService.CreateAgentFromTemplateAsync(selectedTemplateId, agent.Name, agent.LLMProviderId)
            : CreateDefaultAgent();

        CopyAgentConfiguration(agent, agentToCreate);
        agentToCreate.AllowedLocalRootsJson = agent.LocalAutomationEnabled ? AllowedRootsToJson(allowedRootsText) : null;
        agentToCreate.TokenBudgetPerDay = tokenBudget > 0 ? tokenBudget : null;
        if (string.IsNullOrWhiteSpace(agentToCreate.HostMachine))
            agentToCreate.HostMachine = $"worker-{DateTime.UtcNow.Ticks % 99:D2}.xpedeon.local";

        if (scheduleEnabled)
        {
            agentToCreate.Schedule = new AgentSchedule
            {
                CronExpression = cronExpression,
                DefaultInput = scheduleInput,
                Priority = schedulePriority,
                IsEnabled = true,
                CreatedAt = DateTime.UtcNow,
                LastRunAt = null,
                NextRunAt = AgentSchedulerService.ComputeNext(cronExpression, DateTime.UtcNow)
            };
        }

        // Add selected tools
        agentToCreate.Tools = selectedTools.Select(name => new AgentTool
        {
            Name = name,
            Type = ToolType.Custom,
            Description = availableTools.GetValueOrDefault(name).desc ?? name,
            IsEnabled = true
        }).ToList();
        agentToCreate.Skills = selectedSkillIds.Select(id => new AgentSkillAssignment
        {
            SkillDefinitionId = id,
            IsEnabled = true
        }).ToList();

        isSaving = true;
        try
        {
            var created = await AgentService.CreateAsync(agentToCreate, assignedMcpIds.ToList());
            Nav.NavigateTo($"/agents/{created.Id}");
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private string MemorySummary()
    {
        var parts = new List<string>();
        if (agent.ShortTermMemoryEnabled) parts.Add("Short-term");
        if (agent.LongTermMemoryEnabled) parts.Add("Long-term");
        if (agent.ShareMemoryWithSwarm) parts.Add("Swarm shared");
        return parts.Any() ? string.Join(", ", parts) : "None";
    }

    private static int EstimateTokens(string text) => (int)(text.Length / 3.8);

    private static string CronHint(string cron) => cron.Trim() switch
    {
        "0 9 * * *" => "Every day at 9:00 AM",
        "0 * * * *" => "Every hour",
        "*/15 * * * *" => "Every 15 minutes",
        "0 9 * * 1" => "Every Monday at 9:00 AM",
        "0 0 * * *" => "Every day at midnight",
        _ => "Custom cron schedule"
    };

    private string NextRunPreview
        => !scheduleEnabled
            ? "Disabled"
            : AgentSchedulerService.ComputeNext(cronExpression, DateTime.UtcNow).ToLocalTime().ToString("dd MMM yyyy HH:mm");

    private static string AllowedRootsToText(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return string.Empty;

        try
        {
            var roots = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new List<string>();
            return string.Join(Environment.NewLine, roots);
        }
        catch
        {
            return string.Empty;
        }
    }

    private static string? AllowedRootsToJson(string? text)
    {
        var roots = (text ?? string.Empty)
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(root => root.Trim())
            .Where(root => !string.IsNullOrWhiteSpace(root))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        return roots.Count == 0 ? null : System.Text.Json.JsonSerializer.Serialize(roots);
    }

    private static string TypeIcon(AgentType t) => t switch
    {
        AgentType.DataSync     => "bi-arrow-left-right",
        AgentType.Reporting    => "bi-file-earmark-bar-graph",
        AgentType.Integration  => "bi-plug",
        AgentType.Notification => "bi-bell",
        AgentType.Processing   => "bi-cpu",
        AgentType.Custom       => "bi-braces",
        _ => "bi-robot"
    };

    private static string ProviderIcon(LLMProviderType t) => t switch
    {
        LLMProviderType.Claude => "bi-stars",
        LLMProviderType.OpenAI => "bi-lightning-charge",
        LLMProviderType.Ollama => "bi-house-gear",
        LLMProviderType.Custom => "bi-braces",
        _ => "bi-cpu"
    };

    private static Agent CreateDefaultAgent() => new()
    {
        Type = AgentType.Custom,
        Version = "1.0.0",
        MemoryLimitMB = 512,
        TimeoutSeconds = 120,
        MaxRetries = 3,
        CircuitBreakerEnabled = true,
        CircuitBreakerFailureThreshold = 5,
        ShortTermMemoryEnabled = true,
        ConfidenceThreshold = 0.8
    };

    private static void CopyAgentConfiguration(Agent source, Agent target)
    {
        target.Name = source.Name;
        target.Type = source.Type;
        target.Description = source.Description;
        target.ExecutionBackend = source.ExecutionBackend;
        target.LLMProviderId = source.LLMProviderId;
        target.SystemPrompt = source.SystemPrompt;
        target.CurrentTask = source.CurrentTask;
        target.Version = source.Version;
        target.HostMachine = source.HostMachine;
        target.MemoryLimitMB = source.MemoryLimitMB;
        target.ShortTermMemoryEnabled = source.ShortTermMemoryEnabled;
        target.LongTermMemoryEnabled = source.LongTermMemoryEnabled;
        target.ShareMemoryWithSwarm = source.ShareMemoryWithSwarm;
        target.TokenBudgetPerDay = source.TokenBudgetPerDay;
        target.MaxRetries = source.MaxRetries;
        target.TimeoutSeconds = source.TimeoutSeconds;
        target.CircuitBreakerEnabled = source.CircuitBreakerEnabled;
        target.CircuitBreakerFailureThreshold = source.CircuitBreakerFailureThreshold;
        target.IsCircuitOpen = source.IsCircuitOpen;
        target.RequiresApproval = source.RequiresApproval;
        target.ConfidenceThreshold = source.ConfidenceThreshold;
        target.LocalAutomationEnabled = source.LocalAutomationEnabled;
        target.AllowPowerShellScripts = source.AllowPowerShellScripts;
        target.AllowDestructiveActions = source.AllowDestructiveActions;
        target.LocalAutomationApprovalMode = source.LocalAutomationApprovalMode;
        target.AllowedLocalRootsJson = source.AllowedLocalRootsJson;
        target.SpawnEnabled = source.SpawnEnabled;
        target.SpawnMode = source.SpawnMode;
        target.SpawnTriggerType = source.SpawnTriggerType;
        target.SpawnTrigger = source.SpawnTrigger;
        target.MaxSpawns = source.MaxSpawns;
        target.MaxDepth = source.MaxDepth;
        target.ChildPromptTemplate = source.ChildPromptTemplate;
        target.SpawnLifecycle = source.SpawnLifecycle;
        target.SpawnAggregation = source.SpawnAggregation;
        target.TemplateId = source.TemplateId;
    }
}
