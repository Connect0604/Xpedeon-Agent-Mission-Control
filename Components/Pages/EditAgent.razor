@page "/agents/{AgentId}/edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@inject AgentService AgentService
@inject LLMProviderService ProviderService
@inject SkillService SkillService
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject TimeDisplayService TimeDisplay

<PageTitle>Edit Agent — Xpedeon AMC</PageTitle>

@if (agent == null)
{
    <div class="empty-state">
        <div class="empty-icon"><i class="bi bi-robot"></i></div>
        <div class="empty-title">Agent not found</div>
        <a href="/agents" class="btn btn-ghost mt-4"><i class="bi bi-arrow-left"></i> Back</a>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1 class="page-title">Edit Agent</h1>
            <p class="page-subtitle">Update behavior, limits, integrations, and schedule for @agent.Name.</p>
        </div>
        <div style="display:flex;gap:var(--s2);">
            <button class="btn btn-ghost text-error" @onclick="() => showDeleteConfirm = true">
                <i class="bi bi-trash"></i> Delete
            </button>
            <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo($"/agents/{AgentId}")'>
                <i class="bi bi-arrow-left"></i> Cancel
            </button>
        </div>
    </div>

    <div class="edit-agent-layout">

        <!-- Basics -->
        <div class="card card-pad">
            <h3 class="section-title mb-4">Basics</h3>
            <p class="form-section-intro">Keep the identity and description easy to scan in fleet views and task history.</p>
            <div class="form-group">
                <label class="form-label">Agent Name <span class="text-error">*</span></label>
                <input class="form-input" @bind="agent.Name" />
            </div>
            <div class="form-group">
                <label class="form-label">Agent Type</label>
                <div class="type-picker">
                    @foreach (var t in Enum.GetValues<AgentType>())
                    {
                        <button class="type-btn @(agent.Type == t ? "type-btn--active" : "")"
                                @onclick="() => agent.Type = t">
                            <i class="bi @TypeIcon(t)"></i> @t
                        </button>
                    }
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea class="form-input" rows="2" @bind="agent.Description"></textarea>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Host Machine</label>
                    <input class="form-input font-mono" @bind="agent.HostMachine" />
                </div>
                <div class="form-group">
                    <label class="form-label">Version</label>
                    <input class="form-input font-mono" @bind="agent.Version" />
                </div>
            </div>
        </div>

        <!-- LLM & System Prompt -->
        <div class="card card-pad">
            <h3 class="section-title mb-4">LLM Provider & System Prompt</h3>
            <p class="form-section-intro">Adjust where the agent runs, which provider it uses, and how its instructions are framed.</p>
            <div class="form-group">
                <label class="form-label">Execution Backend</label>
                <div class="type-picker">
                    @foreach (var backend in Enum.GetValues<ExecutionBackend>())
                    {
                        <button class="type-btn @(agent.ExecutionBackend == backend ? "type-btn--active" : "")"
                                @onclick="() => agent.ExecutionBackend = backend">
                            <i class="bi @(backend == ExecutionBackend.Local ? "bi-cpu" : "bi-box-arrow-up-right")"></i> @(backend == ExecutionBackend.Local ? "Local" : "Hermes/OpenClaw")
                        </button>
                    }
                </div>
                <div class="form-hint">
                    <i class="bi bi-info-circle"></i>
                    Delegated runs still use the same approval and task history flow, but execution happens in the external Hermes/OpenClaw runtime.
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">LLM Provider</label>
                <div class="provider-picker">
                    @foreach (var p in providers)
                    {
                        <div class="provider-picker-item @(agent.LLMProviderId == p.Id ? "selected" : "")"
                             @onclick="() => agent.LLMProviderId = p.Id">
                            <i class="bi @ProviderIcon(p.Type)"></i>
                            <div>
                                <div class="text-sm font-medium">@p.Name</div>
                                <div class="text-xs font-mono text-muted">@p.ModelName</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">
                    System Prompt
                    @if (!string.IsNullOrWhiteSpace(agent.SystemPrompt))
                    {
                        <span class="text-muted text-xs ml-2">~@EstimateTokens(agent.SystemPrompt) tokens</span>
                    }
                </label>
                <textarea class="form-input prompt-editor" rows="12" @bind="agent.SystemPrompt"></textarea>
                <div class="form-hint">
                    <i class="bi bi-info-circle"></i>
                    Saving a new prompt creates a version history entry automatically.
                </div>
            </div>
        </div>

        <!-- Memory -->
        <div class="card card-pad">
            <h3 class="section-title mb-4">Memory</h3>
            <p class="form-section-intro">Control what the agent retains between runs and what it can share with a swarm.</p>
            <div class="toggle-group">
                <div class="toggle-item">
                    <div>
                        <div class="toggle-label">Short-term Memory</div>
                        <div class="toggle-desc text-muted text-sm">Context within a single run</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="agent.ShortTermMemoryEnabled" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="toggle-item">
                    <div>
                        <div class="toggle-label">Long-term Memory</div>
                        <div class="toggle-desc text-muted text-sm">Persists across runs</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="agent.LongTermMemoryEnabled" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="toggle-item">
                    <div>
                        <div class="toggle-label">Share Swarm Memory</div>
                        <div class="toggle-desc text-muted text-sm">Pool with swarm agents</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="agent.ShareMemoryWithSwarm" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>
        </div>

        <!-- MCP Servers -->
        <div class="card card-pad">
            <h3 class="section-title mb-4">MCP Servers</h3>
            <p class="form-section-intro">Attach non-global MCP servers only when this agent truly needs them.</p>
            @if (!allMcpServers.Any())
            {
                <div class="text-muted text-sm">No MCP servers configured. <a href="/mcp" class="text-accent">Add one first.</a></div>
            }
            else
            {
                <div class="mcp-assign-list">
                    @foreach (var mcp in allMcpServers)
                    {
                        var isAssigned = assignedMcpIds.Contains(mcp.Id);
                        <label class="mcp-assign-row @(isAssigned ? "mcp-assign-row--on" : "")">
                            <input type="checkbox" checked="@isAssigned"
                                   @onchange="e => ToggleMcp(mcp.Id, (bool)(e.Value ?? false))" />
                            <div class="mcp-assign-info">
                                <span class="text-sm font-medium">@mcp.Name</span>
                                @if (mcp.IsGlobal)
                                {
                                    <span class="badge badge-accent ml-2 text-xs">Global</span>
                                }
                                <div class="text-xs font-mono text-muted">@mcp.Endpoint</div>
                            </div>
                            <span class="mcp-transport-badge @mcp.TransportType.ToString().ToLower() ml-auto">@mcp.TransportType</span>
                        </label>
                    }
                </div>
            }
        </div>

        <div class="card card-pad">
            <h3 class="section-title mb-4">Capability Skills</h3>
            <p class="form-section-intro">Attach reusable skills that shape prompts, tool access, and guardrails.</p>
            @if (!allSkills.Any())
            {
                <div class="text-muted text-sm">No skills configured.</div>
            }
            else
            {
                @foreach (var skillGroup in SkillsByCategory(allSkills))
                {
                    <div class="mt-3">
                        <div class="text-xs text-muted mb-2">@skillGroup.Key</div>
                        <div class="skill-pick-grid">
                            @foreach (var skill in skillGroup)
                            {
                                var isAssigned = assignedSkillIds.Contains(skill.Id);
                                <div class="skill-pick-card @(isAssigned ? "skill-pick-card--selected" : "")"
                                     @onclick="() => ToggleSkill(skill.Id)">
                                    <div class="flex items-start gap-3">
                                        <div class="provider-icon provider-icon--custom">
                                            <i class="bi bi-stars"></i>
                                        </div>
                                        <div style="flex:1;">
                                            <div class="text-sm font-medium">@skill.Name</div>
                                            <div class="text-xs text-muted mt-1">@skill.Description</div>
                                            <div class="text-xs text-muted mt-2">
                                                <span class="tag">@skill.Category</span>
                                                @if (skill.RequiresApproval)
                                                {
                                                    <span class="tag">Approval</span>
                                                }
                                                @if (skill.MaxToolCalls.HasValue)
                                                {
                                                    <span class="tag">Max @skill.MaxToolCalls tools</span>
                                                }
                                            </div>
                                        </div>
                                        @if (isAssigned)
                                        {
                                            <i class="bi bi-check-circle-fill text-accent"></i>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="card card-pad">
            <h3 class="section-title mb-4">Local Automation</h3>
            <p class="form-section-intro">Use this for the dedicated agent that should operate on the Mission Control host machine.</p>
            <div class="toggle-group">
                <div class="toggle-item">
                    <div>
                        <div class="toggle-label">Enable Local Automation</div>
                        <div class="toggle-desc text-muted text-sm">Allow this agent to plan and run validated local host actions.</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="agent.LocalAutomationEnabled" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="toggle-item">
                    <div>
                        <div class="toggle-label">Allow PowerShell</div>
                        <div class="toggle-desc text-muted text-sm">Allow PowerShell execution when the plan and approval rules permit it.</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="agent.AllowPowerShellScripts" disabled="@(!agent.LocalAutomationEnabled)" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="toggle-item">
                    <div>
                        <div class="toggle-label">Allow Destructive Actions</div>
                        <div class="toggle-desc text-muted text-sm">Permit delete and overwrite actions after validation.</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="agent.AllowDestructiveActions" disabled="@(!agent.LocalAutomationEnabled)" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>
            @if (agent.LocalAutomationEnabled)
            {
                <div class="form-group mt-4">
                    <label class="form-label">Automation Approval Mode</label>
                    <select class="form-input" @bind="agent.LocalAutomationApprovalMode">
                        <option value="@LocalAutomationApprovalMode.Restricted">Restricted - approve every local action</option>
                        <option value="@LocalAutomationApprovalMode.ApproveRiskyOnly">Approve risky only</option>
                        <option value="@LocalAutomationApprovalMode.FullControl">Full control - no local approval gates</option>
                    </select>
                    <div class="form-hint">
                        <i class="bi bi-info-circle"></i>
                        This controls local automation approvals only. The general agent approval toggle still applies separately.
                    </div>
                </div>

                <div class="form-group mt-4">
                    <label class="form-label">Allowed Root Paths</label>
                    <textarea class="form-input font-mono" rows="4" @bind="allowedRootsText"
                              placeholder="One absolute path per line&#10;C:\Exports&#10;D:\DropFolders"></textarea>
                    <div class="form-hint">
                        <i class="bi bi-info-circle"></i>
                        The agent can only touch files under these roots.
                    </div>
                </div>
            }
        </div>

        <!-- Dynamic Spawning -->
        <div class="card card-pad">
            <h3 class="section-title mb-4">Dynamic Spawning</h3>
            <p class="form-section-intro">Decide whether this agent should break work into child tasks at runtime.</p>
            <div class="toggle-item mb-4">
                <div>
                    <div class="toggle-label">Enable Dynamic Spawning</div>
                    <div class="toggle-desc text-muted text-sm">Spawns child agents at runtime based on task input</div>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="agent.SpawnEnabled" />
                    <span class="toggle-slider"></span>
                </label>
            </div>
            @if (agent.SpawnEnabled)
            {
                <div class="form-group">
                    <label class="form-label">Spawn Mode</label>
                    <div class="strategy-picker">
                        <button class="strategy-btn @(agent.SpawnMode == AgentSpawnMode.RuleBased ? "strategy-btn--active" : "")"
                                @onclick='() => agent.SpawnMode = AgentSpawnMode.RuleBased'>
                            <i class="bi bi-scissors"></i>
                            <div class="strategy-btn__name">Rule-Based</div>
                            <div class="strategy-btn__desc">Split input by pattern</div>
                        </button>
                        <button class="strategy-btn @(agent.SpawnMode == AgentSpawnMode.LLMDecided ? "strategy-btn--active" : "")"
                                @onclick='() => agent.SpawnMode = AgentSpawnMode.LLMDecided'>
                            <i class="bi bi-stars"></i>
                            <div class="strategy-btn__name">LLM-Decided</div>
                            <div class="strategy-btn__desc">LLM decides decomposition</div>
                        </button>
                    </div>
                </div>
                @if (agent.SpawnMode == AgentSpawnMode.RuleBased)
                {
                    <div class="form-group">
                        <label class="form-label">Split Input By</label>
                        <select class="form-input" @bind="agent.SpawnTriggerType">
                            <option value="@AgentSpawnTriggerType.SplitByNewline">New line</option>
                            <option value="@AgentSpawnTriggerType.SplitByComma">Comma-separated</option>
                            <option value="@AgentSpawnTriggerType.JsonArray">JSON array</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Child Prompt Template <span class="text-muted text-xs">optional</span></label>
                        <textarea class="form-input" rows="3" @bind="agent.ChildPromptTemplate"
                                  placeholder="Use {item} and {n}. Leave blank to inherit parent prompt."></textarea>
                    </div>
                }
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Max Spawns</label>
                        <input class="form-input" type="number" @bind="agent.MaxSpawns" min="1" max="100" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Max Depth</label>
                        <input class="form-input" type="number" @bind="agent.MaxDepth" min="1" max="5" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Child Lifecycle</label>
                    <select class="form-input" @bind="agent.SpawnLifecycle">
                        <option value="@AgentSpawnLifecycle.Ephemeral">Ephemeral — deleted after task</option>
                        <option value="@AgentSpawnLifecycle.Pooled">Pooled — returned to Idle</option>
                        <option value="@AgentSpawnLifecycle.Persistent">Persistent — kept with memory</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Result Aggregation</label>
                    <select class="form-input" @bind="agent.SpawnAggregation">
                        <option value="@AgentSpawnAggregation.CollectAll">Collect All</option>
                        <option value="@AgentSpawnAggregation.FirstWins">First Wins</option>
                        <option value="@AgentSpawnAggregation.Voting">Voting</option>
                        <option value="@AgentSpawnAggregation.LLMSynthesize">LLM Synthesize</option>
                    </select>
                </div>
                <div class="spawn-preview-box">
                    <i class="bi bi-info-circle text-accent"></i>
                    <span class="text-sm">
                        Up to <strong>@agent.MaxSpawns</strong> child agents ·
                        <strong>@agent.SpawnLifecycle</strong> lifecycle ·
                        max depth <strong>@agent.MaxDepth</strong>
                    </span>
                </div>
            }
        </div>

        <!-- Advanced -->
        <div class="card card-pad">
            <h3 class="section-title mb-4">Advanced</h3>
            <p class="form-section-intro">Set execution limits, approval rules, and schedule behavior for this agent.</p>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Memory Limit (MB)</label>
                    <input class="form-input" type="number" @bind="agent.MemoryLimitMB" />
                </div>
                <div class="form-group">
                    <label class="form-label">Timeout (seconds)</label>
                    <input class="form-input" type="number" @bind="agent.TimeoutSeconds" />
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Max Retries</label>
                    <input class="form-input" type="number" @bind="agent.MaxRetries" />
                </div>
                <div class="form-group">
                    <label class="form-label">Daily Token Budget</label>
                    <input class="form-input" type="number" @bind="agent.TokenBudgetPerDay" placeholder="Unlimited" />
                </div>
            </div>
            <div class="toggle-group mt-4">
                <div class="toggle-item">
                    <div>
                        <div class="toggle-label">Circuit Breaker</div>
                        <div class="toggle-desc text-muted text-sm">Auto-pause after failures</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="agent.CircuitBreakerEnabled" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
                <div class="toggle-item">
                    <div>
                        <div class="toggle-label">Require Human Approval</div>
                        <div class="toggle-desc text-muted text-sm">Tasks need manual approval</div>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="agent.RequiresApproval" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>
            </div>

            @if (agent.CircuitBreakerEnabled)
            {
                <div class="form-group mt-4">
                    <label class="form-label">Failure Threshold</label>
                    <input class="form-input" type="number" @bind="agent.CircuitBreakerFailureThreshold" min="2" max="20" />
                </div>
            }

            <!-- Schedule -->
            <div class="mt-4">
                <h4 class="section-title mb-3">Schedule (Cron)</h4>
                <label class="form-check mb-3">
                    <input type="checkbox" @bind="scheduleEnabled" />
                    <span>Enable scheduled runs</span>
                </label>
                @if (scheduleEnabled)
                {
                    <div class="form-group mb-3">
                        <label class="form-label">Quick Presets</label>
                        <div class="type-picker">
                            @foreach (var preset in schedulePresets)
                            {
                                <button type="button"
                                        class="type-btn @(cronExpression == preset.Expression ? "type-btn--active" : "")"
                                        @onclick='() => ApplySchedulePreset(preset.Expression)'>
                                    <i class="bi bi-clock-history"></i> @preset.Label
                                </button>
                            }
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Cron Expression</label>
                            <input class="form-input font-mono" @bind="cronExpression" placeholder="0 9 * * *" />
                            <div class="form-hint">
                                <i class="bi bi-info-circle"></i>
                                @CronHint(cronExpression)
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Priority</label>
                            <select class="form-input" @bind="schedulePriority">
                                @foreach (var p in Enum.GetValues<TaskPriority>())
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Default Input</label>
                        <textarea class="form-input" rows="3" @bind="scheduleInput"
                                  placeholder="Default task input sent on each scheduled run..."></textarea>
                    </div>
                    <div class="token-stats">
                        <div class="token-stat">
                            <span class="text-muted text-xs">Next Run</span>
                            <span>@NextRunPreview</span>
                        </div>
                        <div class="token-stat">
                            <span class="text-muted text-xs">Last Run</span>
                            <span>@LastRunPreview</span>
                        </div>
                        <div class="token-stat">
                            <span class="text-muted text-xs">Total Runs</span>
                            <span>@(agent?.Schedule?.TotalRuns ?? 0)</span>
                        </div>
                        <div class="token-stat">
                            <span class="text-muted text-xs">Mode</span>
                            <span>@(agent?.ExecutionBackend == ExecutionBackend.HermesOpenClaw ? "Delegated" : "Local")</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMsg))
        {
            <div class="alert alert-error">@errorMsg</div>
        }

        <div class="form-actions">
            <button class="btn btn-ghost" @onclick='() => Nav.NavigateTo($"/agents/{AgentId}")'>Cancel</button>
            <button class="btn btn-primary ml-auto" @onclick="SaveAgent" disabled="@isSaving">
                @if (isSaving) { <span class="spinner"></span> }
                <i class="bi bi-check-lg"></i> @(isSaving ? "Saving..." : "Save Changes")
            </button>
        </div>
    </div>
}

<!-- Delete Confirm -->
@if (showDeleteConfirm)
{
    <div class="modal-backdrop" @onclick="() => showDeleteConfirm = false">
        <div class="modal modal--sm" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title text-error">Delete Agent</h2>
                <button class="modal-close" @onclick="() => showDeleteConfirm = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="modal-body">
                <p class="text-secondary">Permanently delete <strong class="text-primary">@agent?.Name</strong>?</p>
                <p class="text-muted text-sm mt-2">All tasks, memory, and logs for this agent will be deleted.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-ghost" @onclick="() => showDeleteConfirm = false">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteAgent">Delete Permanently</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string AgentId { get; set; } = "";

    private Agent? agent;
    private List<LLMProvider> providers = new();
    private List<MCPServer> allMcpServers = new();
    private List<SkillDefinition> allSkills = new();
    private HashSet<string> assignedMcpIds = new();
    private HashSet<string> assignedSkillIds = new();
    private bool isSaving;
    private bool showDeleteConfirm;
    private string errorMsg = "";
    private string allowedRootsText = "";

    // Schedule fields
    private bool scheduleEnabled;
    private string cronExpression = "0 9 * * *";
    private string scheduleInput = "";
    private TaskPriority schedulePriority = TaskPriority.Medium;
    private static readonly (string Label, string Expression)[] schedulePresets =
    {
        ("Hourly", "0 * * * *"),
        ("Daily 9 AM", "0 9 * * *"),
        ("Weekdays 9 AM", "0 9 * * 1,2,3,4,5"),
        ("Monday 9 AM", "0 9 * * 1")
    };

    protected override async Task OnInitializedAsync()
    {
        agent = await AgentService.GetByIdAsync(AgentId);
        providers = await ProviderService.GetAllAsync();

        await using var db = DbFactory.CreateDbContext();
        allMcpServers = await db.MCPServers.Where(m => m.IsEnabled).OrderBy(m => m.Name).ToListAsync();
        allSkills = await SkillService.GetAllAsync();

        var existing = await db.AgentMCPServers.Where(a => a.AgentId == AgentId).ToListAsync();
        assignedMcpIds = existing.Select(a => a.MCPServerId).ToHashSet();
        assignedSkillIds = agent?.Skills
            .Where(s => s.IsEnabled)
            .Select(s => s.SkillDefinitionId)
            .ToHashSet() ?? new HashSet<string>();

        if (agent?.Schedule != null)
        {
            scheduleEnabled = agent.Schedule.IsEnabled;
            cronExpression = agent.Schedule.CronExpression;
            scheduleInput = agent.Schedule.DefaultInput ?? "";
            schedulePriority = agent.Schedule.Priority;
        }

        allowedRootsText = AllowedRootsToText(agent?.AllowedLocalRootsJson);
    }

    private void ToggleMcp(string mcpId, bool assigned)
    {
        if (assigned) assignedMcpIds.Add(mcpId);
        else assignedMcpIds.Remove(mcpId);
    }

    private void ToggleSkill(string skillId)
    {
        if (!assignedSkillIds.Remove(skillId)) assignedSkillIds.Add(skillId);
    }

    private static IEnumerable<IGrouping<SkillCategory, SkillDefinition>> SkillsByCategory(IEnumerable<SkillDefinition> skills)
        => skills
            .OrderBy(s => s.Category)
            .ThenBy(s => s.Name)
            .GroupBy(s => s.Category);

    private void ApplySchedulePreset(string expression)
    {
        cronExpression = expression;
    }

    private async Task SaveAgent()
    {
        if (agent == null) return;
        if (string.IsNullOrWhiteSpace(agent.Name)) { errorMsg = "Name is required."; return; }

        isSaving = true;
        errorMsg = "";
        try
        {
            agent.AllowedLocalRootsJson = agent.LocalAutomationEnabled ? AllowedRootsToJson(allowedRootsText) : null;
            await AgentService.UpdateAsync(agent);

            // Save schedule
            await using var db = DbFactory.CreateDbContext();
            var existing = await db.AgentSchedules.FirstOrDefaultAsync(s => s.AgentId == AgentId);
            if (scheduleEnabled)
            {
                if (existing == null)
                {
                    db.AgentSchedules.Add(new AgentSchedule
                    {
                        AgentId = AgentId, CronExpression = cronExpression,
                        DefaultInput = scheduleInput, Priority = schedulePriority,
                        IsEnabled = true, CreatedAt = DateTime.UtcNow,
                        LastRunAt = null,
                        NextRunAt = AgentSchedulerService.ComputeNext(cronExpression, DateTime.UtcNow, TimeDisplay.TimeZone)
                    });
                }
                else
                {
                    existing.CronExpression = cronExpression;
                    existing.DefaultInput = scheduleInput;
                    existing.Priority = schedulePriority;
                    existing.IsEnabled = true;
                    existing.LastRunAt = null;
                    existing.NextRunAt = AgentSchedulerService.ComputeNext(cronExpression, DateTime.UtcNow, TimeDisplay.TimeZone);
                }
            }
            else if (existing != null)
            {
                existing.IsEnabled = false;
                existing.NextRunAt = null;
            }
            await db.SaveChangesAsync();

            // Save MCP assignments
            await using var db2 = DbFactory.CreateDbContext();
            var currentAssignments = await db2.AgentMCPServers.Where(a => a.AgentId == AgentId).ToListAsync();

            // Remove unselected
            var toRemove = currentAssignments.Where(a => !assignedMcpIds.Contains(a.MCPServerId)).ToList();
            db2.AgentMCPServers.RemoveRange(toRemove);

            // Add newly selected
            var existingIds = currentAssignments.Select(a => a.MCPServerId).ToHashSet();
            foreach (var mcpId in assignedMcpIds.Where(id => !existingIds.Contains(id)))
            {
                db2.AgentMCPServers.Add(new AgentMCPServer { AgentId = AgentId, MCPServerId = mcpId });
            }
            await db2.SaveChangesAsync();

            await SkillService.SetAgentSkillsAsync(AgentId, assignedSkillIds);

            Nav.NavigateTo($"/agents/{AgentId}");
        }
        catch (Exception ex) { errorMsg = ex.Message; }
        finally { isSaving = false; }
    }

    private async Task DeleteAgent()
    {
        await AgentService.DeleteAsync(AgentId);
        Nav.NavigateTo("/agents");
    }

    private static string CronHint(string cron) => cron.Trim() switch
    {
        "0 9 * * *"   => "Every day at 9:00 AM",
        "0 * * * *"   => "Every hour",
        "*/15 * * * *" => "Every 15 minutes",
        "0 9 * * 1"   => "Every Monday at 9:00 AM",
        "0 0 * * *"   => "Every day at midnight",
        _ => "Custom cron schedule"
    };

