@page "/tasks"
@rendermode InteractiveServer
@inject TaskService TaskService
@inject MockDataService DataService
@inject NavigationManager Nav

<PageTitle>Tasks — Xpedeon AMC</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">Tasks</h1>
        <p class="page-subtitle">Agent task queue &amp; execution history</p>
    </div>
</div>

<!-- Tab Bar -->
<div class="tab-bar">
    @foreach (var tab in Tabs)
    {
        <button class="tab @(activeTab == tab.key ? "on" : "")" @onclick="() => SetTab(tab.key)">
            @tab.label
            <span class="tab-count">@CountFor(tab.key)</span>
        </button>
    }
</div>

<!-- Filter bar -->
<div class="filter-bar">
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text" placeholder="Search tasks..." @bind="searchQuery" @bind:event="oninput" @bind:after="ApplyFilter" />
    </div>
    @foreach (var prio in Priorities)
    {
        <button class="chip @(prioFilter == prio ? "on" : "")" @onclick="() => TogglePrio(prio)">@prio</button>
    }
</div>

<!-- Pending Approvals Banner -->
@if (pendingApprovals.Any())
{
    <div class="card card-pad mb-4" style="border-color:var(--c-warning-border);background:var(--c-warning-bg);">
        <div class="section-head"><i class="bi bi-hourglass text-warning"></i> @pendingApprovals.Count task(s) awaiting approval</div>
        @foreach (var t in pendingApprovals)
        {
            <div class="approval-row">
                <div>
                    <span class="text-sm font-medium text-primary">@t.Name</span>
                    <span class="text-xs text-muted ml-2">· @t.AgentName</span>
                    @if (!string.IsNullOrWhiteSpace(t.Input))
                    {
                        <div class="text-xs text-muted font-mono mt-1">@t.Input[..Math.Min(100, t.Input.Length)]@(t.Input.Length > 100 ? "..." : "")</div>
                    }
                </div>
                <div style="display:flex;gap:var(--s2);flex-shrink:0;">
                    <button class="btn btn-sm btn-ghost text-error" @onclick="() => CancelTask(t.Id)">
                        <i class="bi bi-x-lg"></i> Reject
                    </button>
                    <button class="btn btn-sm btn-primary" @onclick="() => ApproveTask(t.Id)">
                        <i class="bi bi-check-lg"></i> Approve
                    </button>
                </div>
            </div>
        }
    </div>
}

<!-- Task List -->
@if (!filtered.Any())
{
    <div class="card card-pad empty-state">
        <div class="empty-icon"><i class="bi bi-inbox"></i></div>
        <div class="empty-title">No tasks found</div>
        <div class="empty-desc">Run a task from an agent's detail page.</div>
    </div>
}
else
{
    <div class="task-list">
        @foreach (var task in filtered)
        {
            <div class="task-card @(selectedTask?.Id == task.Id ? "task-card--selected" : "")"
                 @onclick="() => SelectTask(task)">
                <div class="task-card__header">
                    <TaskStatusBadge Status="@task.Status" />
                    <PriorityBadge Priority="@task.Priority" />
                    <span class="text-sm font-medium text-primary ml-2">@task.Name</span>
                    <span class="text-xs text-muted ml-2 font-mono">@task.AgentName</span>
                    <span class="text-xs text-muted ml-auto">@RelTime(task.CreatedAt)</span>
                </div>
                @if (task.Status == AgentTaskStatus.Running)
                {
                    <div class="prog-wrap mt-2">
                        <div class="prog-track"><div class="prog-fill running" style="width:@task.Progress%"></div></div>
                        <span class="prog-label">@task.Progress%</span>
                    </div>
                }
                @if (task.TotalTokens > 0)
                {
                    <div class="task-meta mt-2">
                        <span><i class="bi bi-hash"></i> @task.TotalTokens.ToString("N0") tokens</span>
                        <span><i class="bi bi-currency-dollar"></i> $@task.CostUSD.ToString("F5")</span>
                        @if (!string.IsNullOrWhiteSpace(task.ModelUsed))
                        {
                            <span class="font-mono text-xs">@task.ModelUsed</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

<!-- Task Detail Drawer -->
@if (selectedTask != null)
{
    <div class="card card-pad mt-4 task-detail-panel">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--s4);">
            <div>
                <h3 class="section-title">@selectedTask.Name</h3>
                <p class="text-muted text-sm">
                    @selectedTask.AgentName ·
                    <a href="/agents/@selectedTask.AgentId" class="text-accent">View Agent</a>
                </p>
            </div>
            <button class="btn btn-ghost btn-sm" @onclick="() => selectedTask = null"><i class="bi bi-x-lg"></i></button>
        </div>

        @if (!string.IsNullOrWhiteSpace(selectedTask.Input))
        {
            <div class="form-group">
                <label class="form-label text-xs text-muted">Input</label>
                <div class="output-box">@selectedTask.Input</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(selectedTask.Output))
        {
            <div class="form-group">
                <label class="form-label text-xs text-muted">Output</label>
                <div class="output-box output-box--success">@selectedTask.Output</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(selectedTask.ErrorMessage))
        {
            <div class="form-group">
                <label class="form-label text-xs text-muted">Error</label>
                <div class="output-box output-box--error">@selectedTask.ErrorMessage</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(selectedTask.ExecutionTrace))
        {
            <div class="form-group">
                <label class="form-label text-xs text-muted">Execution Trace</label>
                <div class="output-box font-mono text-xs">@selectedTask.ExecutionTrace</div>
            </div>
        }

        @if (selectedTask.TotalTokens > 0)
        {
            <div class="token-stats">
                <div class="token-stat">
                    <span class="text-muted text-xs">Prompt Tokens</span>
                    <span class="font-mono">@selectedTask.PromptTokens.ToString("N0")</span>
                </div>
                <div class="token-stat">
                    <span class="text-muted text-xs">Completion Tokens</span>
                    <span class="font-mono">@selectedTask.CompletionTokens.ToString("N0")</span>
                </div>
                <div class="token-stat">
                    <span class="text-muted text-xs">Total Tokens</span>
                    <span class="font-mono font-medium">@selectedTask.TotalTokens.ToString("N0")</span>
                </div>
                <div class="token-stat">
                    <span class="text-muted text-xs">Cost</span>
                    <span class="font-mono">$@selectedTask.CostUSD.ToString("F6")</span>
                </div>
            </div>
        }

        @if (selectedTask.Status == AgentTaskStatus.Completed && selectedTask.FeedbackRating == null)
        {
            <div class="feedback-row mt-4">
                <span class="text-muted text-xs">Was this output useful?</span>
                <button class="btn btn-ghost btn-sm text-success" @onclick="() => SubmitFeedback(selectedTask, 5)">
                    <i class="bi bi-hand-thumbs-up"></i> Yes
                </button>
                <button class="btn btn-ghost btn-sm text-error" @onclick="() => SubmitFeedback(selectedTask, 1)">
                    <i class="bi bi-hand-thumbs-down"></i> No
                </button>
            </div>
        }
        @if (selectedTask.FeedbackRating != null)
        {
            <div class="text-xs text-muted mt-3">
                <i class="bi bi-check-circle text-success"></i> Feedback recorded
            </div>
        }
    </div>
}

@code {
    private List<AgentTask> allTasks = new();
    private List<AgentTask> filtered = new();
    private List<AgentTask> pendingApprovals = new();
    private AgentTask? selectedTask;
    private string activeTab = "all";
    private string searchQuery = "";
    private TaskPriority? prioFilter;
    private Timer? _timer;

    private record TabDef(string key, string label);
    private static readonly TabDef[] Tabs =
    {
        new("all",       "All"),
        new("running",   "Running"),
        new("pending",   "Pending Approval"),
        new("queued",    "Queued"),
        new("completed", "Completed"),
        new("failed",    "Failed"),
    };
    private static readonly TaskPriority[] Priorities = Enum.GetValues<TaskPriority>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _timer = new Timer(async _ => { await LoadAsync(); await InvokeAsync(StateHasChanged); },
            null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private async Task LoadAsync()
    {
        allTasks = await TaskService.GetAllAsync(200);
        pendingApprovals = allTasks.Where(t => t.Status == AgentTaskStatus.PendingApproval).ToList();
        ApplyFilter();
        if (selectedTask != null)
            selectedTask = allTasks.FirstOrDefault(t => t.Id == selectedTask.Id) ?? selectedTask;
    }

    private void ApplyFilter()
    {
        var q = allTasks.AsEnumerable();
        q = activeTab switch
        {
            "running"   => q.Where(t => t.Status == AgentTaskStatus.Running),
            "pending"   => q.Where(t => t.Status == AgentTaskStatus.PendingApproval),
            "queued"    => q.Where(t => t.Status == AgentTaskStatus.Queued),
            "completed" => q.Where(t => t.Status == AgentTaskStatus.Completed),
            "failed"    => q.Where(t => t.Status == AgentTaskStatus.Failed),
            _ => q
        };
        if (prioFilter.HasValue) q = q.Where(t => t.Priority == prioFilter.Value);
        if (!string.IsNullOrWhiteSpace(searchQuery))
            q = q.Where(t => t.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                           || t.AgentName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
        filtered = q.OrderByDescending(t => t.CreatedAt).ToList();
    }

    private int CountFor(string tab) => tab switch
    {
        "running"   => allTasks.Count(t => t.Status == AgentTaskStatus.Running),
        "pending"   => allTasks.Count(t => t.Status == AgentTaskStatus.PendingApproval),
        "queued"    => allTasks.Count(t => t.Status == AgentTaskStatus.Queued),
        "completed" => allTasks.Count(t => t.Status == AgentTaskStatus.Completed),
        "failed"    => allTasks.Count(t => t.Status == AgentTaskStatus.Failed),
        _ => allTasks.Count
    };

    private void SetTab(string tab) { activeTab = tab; ApplyFilter(); }
    private void TogglePrio(TaskPriority p) { prioFilter = prioFilter == p ? null : p; ApplyFilter(); }
    private void SelectTask(AgentTask task) => selectedTask = selectedTask?.Id == task.Id ? null : task;

    private async Task ApproveTask(string id)
    {
        await TaskService.ApproveTaskAsync(id);
        await LoadAsync();
    }

    private async Task CancelTask(string id)
    {
        await TaskService.CancelTaskAsync(id);
        await LoadAsync();
    }

    private async Task SubmitFeedback(AgentTask task, int rating)
    {
        await TaskService.SubmitFeedbackAsync(task.Id, rating, null, null);
        await LoadAsync();
    }

    private static string RelTime(DateTime dt)
    {
        var d = DateTime.UtcNow - dt;
        return d.TotalSeconds < 60 ? "just now"
             : d.TotalMinutes < 60 ? $"{(int)d.TotalMinutes}m ago"
             : d.TotalHours < 24   ? $"{(int)d.TotalHours}h ago"
             : $"{(int)d.TotalDays}d ago";
    }

    public void Dispose() => _timer?.Dispose();
}
