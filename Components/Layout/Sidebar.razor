@inject MockDataService DataService
@inject NavigationManager Nav
@implements IDisposable
@rendermode InteractiveServer

<nav class="sidebar @(IsOpen ? "open" : "")" aria-label="Main navigation">
    <!-- Brand -->
    <div class="sidebar-brand">
        <div class="brand-icon" aria-hidden="true">
            <i class="bi bi-broadcast-pin"></i>
        </div>
        <div class="brand-text">
            <span class="brand-name">Xpedeon</span>
            <span class="brand-sub">Agent Platform</span>
        </div>
    </div>

    <!-- Navigation -->
    <div class="sidebar-nav">
        <div class="nav-section">Overview</div>

        <NavLink class="nav-item" href="/" Match="NavLinkMatch.All">
            <i class="bi bi-grid-1x2" aria-hidden="true"></i>
            Dashboard
        </NavLink>

        <div class="nav-section">Agents</div>

        <NavLink class="nav-item" href="/agents" Match="NavLinkMatch.All">
            <i class="bi bi-robot" aria-hidden="true"></i>
            All Agents
            @if (errorCount > 0)
            {
                <span class="nav-badge error" aria-label="@errorCount errors">@errorCount</span>
            }
        </NavLink>

        <NavLink class="nav-item" href="/agents/create">
            <i class="bi bi-plus-circle" aria-hidden="true"></i>
            Create Agent
        </NavLink>

        <NavLink class="nav-item" href="/templates">
            <i class="bi bi-layout-text-window" aria-hidden="true"></i>
            Templates
        </NavLink>

        <NavLink class="nav-item" href="/swarms">
            <i class="bi bi-diagram-3" aria-hidden="true"></i>
            Swarms
        </NavLink>

        <div class="nav-section">Operations</div>

        <NavLink class="nav-item" href="/tasks">
            <i class="bi bi-list-task" aria-hidden="true"></i>
            Tasks
            @if (runningCount > 0)
            {
                <span class="nav-badge info" aria-label="@runningCount running">@runningCount</span>
            }
        </NavLink>

        <NavLink class="nav-item" href="/logs">
            <i class="bi bi-terminal" aria-hidden="true"></i>
            Logs
        </NavLink>

        <div class="nav-section">Configuration</div>

        <NavLink class="nav-item" href="/providers">
            <i class="bi bi-cpu" aria-hidden="true"></i>
            LLM Providers
        </NavLink>

        <NavLink class="nav-item" href="/mcp">
            <i class="bi bi-plug" aria-hidden="true"></i>
            MCP Servers
        </NavLink>
    </div>

    <!-- System Status Footer -->
    <div class="sidebar-footer">
        <div class="sys-status-label">System Status</div>
        <div class="sys-status-row">
            <div class="sys-stat">
                <span class="dot @(errorCount == 0 ? "active" : "error") sm" aria-hidden="true"></span>
                <span>@(errorCount == 0 ? "Healthy" : $"{errorCount} issues")</span>
            </div>
            <div class="sys-stat text-muted text-xs">
                <i class="bi bi-hdd-rack" aria-hidden="true"></i>
                @activeCount/@totalCount online
            </div>
        </div>
    </div>
</nav>

@code {
    [Parameter] public bool IsOpen { get; set; }

    private int errorCount;
    private int activeCount;
    private int totalCount;
    private int runningCount;

    protected override void OnInitialized()
    {
        Refresh();
        DataService.OnDataChanged += HandleChange;
    }

    private void HandleChange()
    {
        Refresh();
        InvokeAsync(StateHasChanged);
    }

    private void Refresh()
    {
        var agents = DataService.GetAgents();
        var tasks  = DataService.GetTasks();
        errorCount   = agents.Count(a => a.Status is AgentStatus.Error or AgentStatus.Offline);
        activeCount  = agents.Count(a => a.Status is AgentStatus.Active or AgentStatus.Idle);
        totalCount   = agents.Count;
        runningCount = tasks.Count(t => t.Status == AgentTaskStatus.Running);
    }

    public void Dispose() => DataService.OnDataChanged -= HandleChange;
}
