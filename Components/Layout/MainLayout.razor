@rendermode InteractiveServer
@inherits LayoutComponentBase

<div class="app-shell @(_sidebarCollapsed ? "sidebar-collapsed" : "") @(_sidebarOpen ? "sidebar-mobile-open" : "")">
    <Sidebar IsOpen="_sidebarOpen" IsCollapsed="_sidebarCollapsed" OnToggleCollapse="ToggleDesktopSidebar" OnNavigate="HandleNavigation" />

    @if (_sidebarOpen)
    {
        <div class="sidebar-overlay open" @onclick="CloseSidebar"></div>
    }

    <div class="main-wrapper">
        <TopBar OnMenuClick="ToggleSidebar" />
        <main class="page-content" role="main">
            <div class="page-content-inner">
                @Body
            </div>
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">&#10006;</a>
</div>

@code {
    private bool _sidebarOpen;
    private bool _sidebarCollapsed;

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private void ToggleDesktopSidebar() => _sidebarCollapsed = !_sidebarCollapsed;

    private void CloseSidebar()  => _sidebarOpen = false;
    private void HandleNavigation() => _sidebarOpen = false;
}
