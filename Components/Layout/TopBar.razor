@inject NavigationManager Nav
@implements IDisposable

<header class="topbar">
    <div class="topbar-left">
        <button class="mobile-menu-btn" @onclick="OnMenuClick" aria-label="Toggle navigation">
            <i class="bi bi-list"></i>
        </button>
        <div class="topbar-heading">
            <span class="topbar-crumb">Mission Control</span>
            <span class="topbar-title">@PageTitle</span>
        </div>
    </div>
    <div class="topbar-right">
        <div class="live-pill" aria-label="Realtime updates enabled">
            <span class="dot active sm" aria-hidden="true"></span>
            Realtime
        </div>
        <span class="topbar-time" aria-live="off">Updated @currentTime</span>
        <button class="topbar-icon-btn" title="Reload page" aria-label="Reload page" @onclick="RefreshPage">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnMenuClick { get; set; }
    private string currentTime = "";
    private Timer? _clockTimer;

    private string PageTitle => Nav.Uri.TrimEnd('/') switch
    {
        var u when u.Contains("/agents/create")  => "Create Agent",
        var u when u.Contains("/agents/")        => "Agent Detail",
        var u when u.EndsWith("/agents")         => "Agents",
        var u when u.EndsWith("/tasks")          => "Tasks",
        var u when u.EndsWith("/outputs")        => "Outputs",
        var u when u.EndsWith("/logs")           => "Logs",
        var u when u.EndsWith("/providers")      => "LLM Providers",
        var u when u.EndsWith("/templates")      => "Agent Templates",
        var u when u.EndsWith("/swarms")         => "Swarms",
        var u when u.EndsWith("/mcp")            => "MCP Servers",
        _ => "Dashboard"
    };

    protected override void OnInitialized()
    {
        Tick();
        _clockTimer = new Timer(_ => InvokeAsync(() => { Tick(); StateHasChanged(); }),
            null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Tick() => currentTime = DateTime.Now.ToString("HH:mm:ss");
    private void RefreshPage() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    public void Dispose() => _clockTimer?.Dispose();
}
