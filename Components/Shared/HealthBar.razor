@* Horizontal health bar segment *@

<div style="display:flex; align-items:center; gap:var(--s3);">
    <span style="font-size:12px; color:var(--txt-secondary); width:50px; flex-shrink:0;">@Label</span>
    <div style="flex:1; height:6px; background:rgba(255,255,255,0.05); border-radius:3px; overflow:hidden;">
        <div style="height:100%; border-radius:3px; background:@Color; width:@Pct%; transition:width 600ms ease;"></div>
    </div>
    <span style="font-size:12px; font-weight:600; color:var(--txt-secondary); width:16px; text-align:right; flex-shrink:0;">@Value</span>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public int    Value { get; set; }
    [Parameter] public int    Total { get; set; }
    [Parameter] public string Color { get; set; } = "var(--accent)";

    private double Pct => Total > 0 ? (double)Value / Total * 100 : 0;
}
