@* Agent summary card for the grid view *@

<a class="agent-card s-@StatusClass" href="/agents/@Agent.Id">
    <div class="agent-card-header">
        <div class="agent-avatar" style="background:@TypeBg; color:@TypeColor; border:1px solid @TypeBorder;">
            <i class="bi @TypeIcon"></i>
        </div>
        <div class="agent-info">
            <div class="agent-name">@Agent.Name</div>
            <div class="agent-host">@Agent.HostMachine</div>
        </div>
        <StatusBadge Status="@Agent.Status" />
    </div>

    <div class="agent-task">
        <i class="bi bi-arrow-right-circle"></i>
        <span class="truncate">@Agent.CurrentTask</span>
    </div>

    @if (Agent.Status != AgentStatus.Offline)
    {
        <div class="agent-bars">
            <div class="bar-row">
                <span class="bar-label">CPU</span>
                <div class="bar-track">
                    <div class="bar-fill @CpuClass" style="width:@Agent.CpuUsage.ToString("F0")%"></div>
                </div>
                <span class="bar-val">@Agent.CpuUsage.ToString("F0")%</span>
            </div>
            <div class="bar-row">
                <span class="bar-label">MEM</span>
                <div class="bar-track">
                    <div class="bar-fill mem" style="width:@MemPct.ToString("F0")%"></div>
                </div>
                <span class="bar-val">@Agent.MemoryUsageMB.ToString("F0")M</span>
            </div>
        </div>
    }

    <div class="agent-footer">
        <div class="agent-stats">
            <div class="agent-stat text-success">
                <i class="bi bi-check2"></i>
                <span class="n">@Agent.TasksCompleted</span>
            </div>
            <div class="agent-stat text-error">
                <i class="bi bi-x"></i>
                <span class="n">@Agent.TasksFailed</span>
            </div>
        </div>
        <span class="text-xs text-muted">up @Agent.UptimeFormatted</span>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public Agent Agent { get; set; } = null!;

    private string StatusClass => Agent.Status switch
    {
        AgentStatus.Active  => "active",
        AgentStatus.Idle    => "idle",
        AgentStatus.Warning => "warning",
        AgentStatus.Error   => "error",
        AgentStatus.Offline => "offline",
        _ => "idle"
    };

    private double MemPct => Agent.MemoryLimitMB > 0
        ? Agent.MemoryUsageMB / Agent.MemoryLimitMB * 100 : 0;

    private string CpuClass => Agent.CpuUsage >= 85 ? "danger" : Agent.CpuUsage >= 70 ? "warn" : "cpu";

    private (string icon, string bg, string color, string border) TypeStyle => Agent.Type switch
    {
        AgentType.DataSync      => ("bi-arrow-repeat",      "rgba(6,182,212,0.12)",   "#06b6d4", "rgba(6,182,212,0.25)"),
        AgentType.Reporting     => ("bi-file-bar-graph",    "rgba(167,139,250,0.12)", "#a78bfa", "rgba(167,139,250,0.25)"),
        AgentType.Integration   => ("bi-plugin",            "rgba(251,146,60,0.12)",  "#fb923c", "rgba(251,146,60,0.25)"),
        AgentType.Notification  => ("bi-bell",              "rgba(250,204,21,0.12)",  "#facc15", "rgba(250,204,21,0.25)"),
        AgentType.Processing    => ("bi-cpu",               "rgba(96,165,250,0.12)",  "#60a5fa", "rgba(96,165,250,0.25)"),
        _ => ("bi-robot", "rgba(100,116,139,0.12)", "#94a3b8", "rgba(100,116,139,0.2)")
    };

    private string TypeIcon   => TypeStyle.icon;
    private string TypeBg     => TypeStyle.bg;
    private string TypeColor  => TypeStyle.color;
    private string TypeBorder => TypeStyle.border;
}
